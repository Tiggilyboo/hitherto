
# read: fd buf count -> result
# Linux syscall 0
[ :read
    $3 !        # count
    $2 !        # buffer address
    $1 !        # file descriptor
    0 $0 !      # SYS_read
    sys
    $0 @        # return value
]

# write: fd buf count -> result
# Linux syscall 1
[ :write
    $3 !        # count
    $2 !        # buffer address
    $1 !        # file descriptor
    1 $0 !      # SYS_write
    sys
    $0 @        # return value
]

# open: filename -> fd
# Linux syscall 2
[ :open
    0 $2 !      # mode
    0 $1 !      # O_RDONLY
    $0 !        # filename address
    2 $0 !      # SYS_open
    sys
    $0 @        # return fd
]

# exit: status -> nothing
# Linux syscall 60
[ :exit
    $1 !        # exit status
    60 $0 !     # SYS_exit
    sys
]

# standard types
[ :u8
    [ :@
        [ 0x4d 0x0f 0xb6 0x6d 0x00 asm ]
    ]
]

# must end on newline

