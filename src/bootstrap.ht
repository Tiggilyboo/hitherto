[ :linux
    # read: fd buf count -> result
    # Linux syscall 0
    [ :read
        $3 !        # count
        $2 !        # buffer address
        $1 !        # file descriptor
        0 $0 !      # SYS_read
        sys
        $0 @        # return value
    ]

    # write: fd buf count -> result
    # Linux syscall 1
    [ :write
        $3 !        # count
        $2 !        # buffer address
        $1 !        # file descriptor
        1 $0 !      # SYS_write
        sys
        $0 @        # return value
    ]

    # open: filename -> fd
    # Linux syscall 2
    [ :open
        0 $2 !      # mode
        0 $1 !      # O_RDONLY
        $0 !        # filename address
        2 $0 !      # SYS_open
        sys
        $0 @        # return fd
    ]

    # exit: status -> nothing
    # Linux syscall 60
    [ :exit
        $1 !        # exit status
        60 $0 !     # SYS_exit
        sys
    ]

    # mmap: length -> result
    # Linux syscall 9
    [ :mmap
        $2 !        # length, consume from stack
        9 $0 !      # SYS_MMAP
        0 $1 !      # addr = null
        3 $3 !      # PROT_READ | PROT_WRITE
        34 $4 !     # MAP_PRIVATE | MAP_ANONYMOUS
        -1 $5 !     # fd
        0 $6 !      # offset
        sys
        $0 @        # return value
    ]
]

[ :nop ]

# arena allocator
[ :arena
    [ :ptr
        [ :init
            [ :mmap-err
                -1
                linux~exit
            ]
            1048576 linux~mmap
            [
                ^ 0 < ? mmap-err
            ]

            # [base + 0] = base + 16
            ^ 16 + <^ !

            # [base + 8] = base + 1048576
            ^ 1048576 + <^ 8 + !

            lit
            immediate
        ]
        init
    ]
    [ :cursor
        ptr @
    ]
    [ :seek
        ptr !
    ]
    [ :end
        ptr 8 + @
    ]
    [ :len
        end ptr -
    ]
    [ :remaining
        end cursor -
    ]
    [ :used
        ptr 16 +
        cursor ptr 16 + -
    ]
    [ :span
        ptr 16 +
        used
    ]
    [ :alloc
        [ :overflow
            1 linux~exit
        ]
        cursor ><

        # preserve cursor and increment
        <^ +

        # if > end, fail
        [
            ^ end >< < ? overflow
        ]

        # store next as new cursor, discard it
        # leaves old cursor as allocation result
        ^ seek _
    ]
]

# standard types
[ :u8
    [ :@
        [ 0x4d 0x0f 0xb6 0x6d 0x00 asm ]
    ]
    [ :read
        [ :abort 1 linux~exit ]

        ^ # keep ptr
        0 >< # fd buf
        1 # count 
        linux~read
        1 = 0 = ? abort
    ]
]

# String literals
[ :"
    [ :overflow 1 linux~exit ]
    [ :done
        <^ -
        # ptr len
        >< lit lit
    ]

    arena~cursor
    [
        arena~cursor
        ^ arena~end < 0 = ? overflow

        u8~read

        ^ u8~@
        34 = ? done
        _

        arena~cursor 1 +
        arena~seek

        ~[
    ]
    immediate
]

[ :memory
    [ :ptr ]
    [ :len ]
    [ :span ptr len ]
]

# str is a printable memory span (ie. the string type)
[ memory:str
    [ :.
        [ :write-err 1 linux~exit ]
        1 # stdout
        span
        linux~write
        0 < ? write-err
    ]
]

[ :debugger ( :frame -- )
    [ :emit ( :c -- )
        c $7 !
        1 $0 !
        1 $1 !
        $7 $2 !
        1 $3 !
        sys
    ]
    [ :name ( :node -- )
        1 $0 !
        1 $1 !
        node 32 + $2 !
        node 24 + @ 32 >> 8 - $3 !
        sys
        10 emit
    ]
    [ :addr ' lit immediate ]
    [ :state ]
    [ :dictionary-not-found ]
    [ :dictionary-overflow ]
    [ :stack-underflow ]
    [ :stack-overflow ]
    [ :token-invalid ]
    [ :token-overflow ]
    [ :token-not-closed ]
    [ :token-not-open ]
    [ :compile-node ]
    [ :division-by-zero ]
    [ :invalid-local ]
    
    [ :debug-state addr state name ]
    [ :debug-dictionary-not-found addr dictionary-not-found name ]
    [ :debug-dictionary-overflow addr dictionary-overflow name ]
    [ :debug-stack-underflow addr stack-underflow name ]
    [ :debug-stack-overflow addr stack-overflow name ]
    [ :debug-token-invalid addr token-invalid name ]
    [ :debug-token-overflow addr token-overflow name ]
    [ :debug-token-not-closed addr token-not-closed name ]
    [ :debug-token-not-open addr token-not-open name ]
    [ :debug-compile-node addr compile-node name ]
    [ :debug-division-by-zero addr division-by-zero name ]
    [ :debug-invalid-local addr invalid-local name ]

    frame @
    ^ 1 = ? debug-state
    ^ 2 = ? debug-dictionary-not-found
    ^ 3 = ? debug-dictionary-overflow
    ^ 4 = ? debug-stack-underflow
    ^ 5 = ? debug-stack-overflow
    ^ 6 = ? debug-token-invalid
    ^ 7 = ? debug-token-overflow
    ^ 8 = ? debug-token-not-closed
    ^ 9 = ? debug-token-not-open
    ^ 10 = ? debug-compile-node
    ^ 11 = ? debug-division-by-zero
    ^ 12 = ? debug-invalid-local
    .
]
# register it
' debugger panic !

# underflow test
_

# must end on newline
