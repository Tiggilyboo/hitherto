# read: fd buf count -> result
# Linux syscall 0
: read
    $3 !        # count
    $2 !        # buffer address
    $1 !        # file descriptor
    0 $0 !      # SYS_read
    sys
    $0 @        # return value
;

# write: fd buf count -> result
# Linux syscall 1
: write
    $3 !        # count
    $2 !        # buffer address
    $1 !        # file descriptor
    1 $0 !      # SYS_write
    sys
    $0 @        # return value
;

# exit: status -> nothing
# Linux syscall 60
: exit
    $1 !        # exit status
    60 $0 !     # SYS_exit
    sys
;

: a 323 ;
: b 234 ;
: c -1 ;
: test
    c ? a
    c ? b
    b ? c
;
