# words which point to internal core qword addresses in kernel
[ :core
    # 0..31 can be accessed via $0..31 for register bank
    [ :panic-handler $32 ]
    [ :io-data $33 ]
    [ :io-length $34 ]
]

[ :addr ]
[ :cell
    [ :field ( :v :offset :mask -- :o )
        v
        offset >>
        mask
        &
        to o
    ]
]

[ cell:b8
    [ :mask ( -- :v )
        0xff to v
        immediate
    ]

    [ :& 0xff & ]
    [ :@
        [ 0x4d 0x0f 0xb6 0x6d 0x00 asm ]
    ]
    [ :!
        [
            0x41 0x8a 0x47 0xf8       # mov al, byte ptr [r15 - 8]
            0x41 0x88 0x45 0x00       # mov byte ptr [r13], al
            asm
        ]
        _ _
    ]
]
[ cell:b16
    [ :mask ( -- :v )
        0xffff to v
        immediate
    ]

    [ :& 0xffff & ]
    [ :@
        [
            # movzx r13, word ptr [r13]
            0x4d 0x0f 0xb7 0x6d 0x00
            asm
        ]
    ]
    [ :!
        [
            0x66 0x41 0x8b 0x47 0xf8p # mov ax, word ptr [r15 - 8]
            0x66 0x41 0x89 0x45 0x00 # mov word ptr [r13], ax
            asm
        ]
        _ _
    ]
]
[ cell:b32
    [ :mask ( -- :v )
        0xffffffff to v
        immediate
    ]

    [ :& 0xffffffff & ]

    [ :@
        [
            # mov r13d, dword ptr [r13]
            0x45 0x8b 0x6d 0x00
            asm
        ]
    ]
    [ :!
        [
            0x41 0x8b 0x47 0xf8 # mov eax, dword ptr [r15 - 8]
            0x41 0x89 0x45 0x00 # mov dword ptr [r13], eax
            asm
        ]
        _ _
    ]
]
[ cell:b64
    [ :mask ( -- :v )
        0xffffffffffffffff to v
        immediate
    ]

    [ :& ] # noop, already 64 bit qword
    [ :@
        # mov r13, qword ptr [r13]
        [ 0x4d 0x8b 0x6d 0x00 asm ]
    ]
    [ :!
        [
            0x49 0x8b 0x47 0xf8 # mov rax, qword ptr [r15 - 8]
            0x49 0x89 0x45 0x00 # mov qword ptr [r13], rax
            asm
        ]
        _ _
    ]
]
[ b8:u8 ]
[ b16:u16 ]
[ b32:u32 ]
[ b64:u64 ]

[ b8:i8
    # mask 8 bits, then sign extend
    [ :&
        b8~&
        [
            # movsx r13, r13b
            0x4d 0x0f 0xbe 0xed 
            asm
        ]
    ]
    [ :@
        [
            # movsx r13, byte ptr [r13]
            0x4d 0x0f 0xbe 0x6d 0x00 
            asm
        ]
    ]
]

[ b16:i16
    [ :&
        b16~&
        [
            # movsx r13, r13w
            0x4d 0x0f 0xbf 0xed
            asm
        ]
    ]
    [ :@
        [
            # movsx r13, word ptr [r13]
            0x4d 0x0f 0xbf 0x6d 0x00
            asm
        ]
    ]
]
[ b32:i32
    [ :&
        b32~&
        [
            # movsxd r13, r13d
            0x4d 0x64 0xed
            asm
        ]
    ]
    [ :@
        [
            # movsxd r13, dword ptr [r13]
            0x4d 0x64 0x6d 0x00
            asm
        ]
    ]
]
[ b64:i64
    # passthrough: builtins already do this
]

[ :memory
    [ addr:ptr ]
    [ u64:len ]
    [ :span
        ^ ptr
        >< len
    ]
]

# str is a printable memory span (ie. the string type)
[ memory:str
    [ addr:ptr
        ^ @
        u32~&
        +
    ]
    [ :len
        @
        ^
        32 >>
        ><
        u32~&
        -
    ]
    [ :.
        [ :err 13 panic ]
        1 # stdout
        ><
        span
        linux~write
        0 < ? err
    ]
]

[ :linux
    [ :read ( u32:fd addr:buf u64:count -- :result )
        fd $1 !
        buf $2 !
        count $3 !

        0 $0 !
        sys
        $0 @ to result
    ]

    [ :write ( u32:fd addr:buf u64:count -- :result )
        fd $1 !
        buf $2 !
        count $3 !
        
        1 $0 !
        sys
        $0 @ to result
    ]

    [ :open-raw ( addr:path u32:flags u32:mode -- u32:fd )
        path $1 !
        flags $2 !
        mode $3 !
        2 $0 !
        sys
        $0 @ to fd
    ]
    [ :open ( str:path u32:flags u32:mode -- u32:fd )
        path~ptr
        open-raw
    ]
    
    [ :exit ( u32:code  -- )
        code $1 !
        60 $0 !
        sys
    ]

    [ :mmap ( addr:ptr u64:len u32:prot u32:flags u32:fd u32:offset -- :result )
        9 $0 !
        ptr $1 !
        len $2 !
        prot $3 !
        scope $4 !
        addr $5 !
        offset $6 !
        sys
        $0 @ to result
    ]
]

[ :input
    [ :data core~io-data ]
    [ :len core~io-length ]

    [ :span
        data
        len @
    ]

    [ :eof ]
    [ :error ]

    [ :refill
        0
        data
        8
        linux~read

        ^ 0 < ? error
        ^ 0 = ? eof

        len !
    ]
    
    [ :read ( -- u8:v )
        [
            len @ 0 = ? refill
        ]

        data @
        u8~& to v

        data @ 8 >> data !
        len @ 1 - len !
    ]
]
[ input:str-parser
    [ :eof 8 panic ]
    [ :error 13 panic ]
]


# arena allocator
[ :arena
    [ :ptr
        [ :init
            [ :mmap-err
                -1
                linux~exit
            ]
            1048576 linux~mmap
            [
                ^ 0 < ? mmap-err
            ]

            # [base + 0] = base + 16
            ^ 16 + <^ !

            # [base + 8] = base + 1048576
            ^ 1048576 + <^ 8 + !

            lit
            immediate
        ]
        init
    ]
    [ :cursor
        ptr @
    ]
    [ :seek
        ptr !
    ]
    [ :end
        ptr 8 + @
    ]
    [ :len
        end ptr -
    ]
    [ :remaining
        end cursor -
    ]
    [ :used
        ptr 16 +
        cursor ptr 16 + -
    ]
    [ :span
        ptr 16 +
        used
    ]
    [ :alloc
        [ :overflow 3 panic ]
        cursor ><

        # preserve cursor and increment
        <^ +

        # if > end, fail
        [
            ^ end >< < ? overflow
        ]

        # store next as new cursor, discard it
        # leaves old cursor as allocation result
        ^ seek _
    ]
]


# String literals
[ :"
    [ :overflow
        3 panic
    ]
    [ :done ( str:s u8:c -- )
        arena~cursor
        s -
        32 <<
        8 |
        s !

        s lit
    ]

    # reserve qword length
    8 arena~alloc

    [
        # stack: str cursor
        arena~cursor
        ^ arena~end < 0 = ? overflow
        _

        # str char
        str-parser~read

        # check if character is "
        ^ 34 = ? done

        # str char cursor -> str
        arena~cursor
        u8~!
        
        arena~cursor
        1 +
        arena~seek

        ~[
    ]

    immediate
]

# kernel/core node format for internal representation of memory for a word
[ :node
    [ :code ( -- :v )
        @
        to v
    ]
    [ :type ( -- node:v )
        8 +
        @
        -8 &
        to v
    ]
    [ :end ( -- :v )
        16 +
        @
        to v
    ]
    [ :body ( -- :v )
        24 +
        to v
    ]
    [ :name ( -- str:v )
        body
        to v
    ]
]

[ :frame
    [ :code ( -- :v )
        @
        to v
    ]

    [ :state ( -- :v )
        8 +
        @
        to v
    ]

    [ :definition ( -- node:v )
        16 +
        @
        to v
    ]

    [ :scope ( -- :v )
        24 +
        @
        to v
    ]

    [ :instruction ( -- :v )
        32 +
        @
        to v
    ]

    [ :tos ( -- :v )
        40 +
        @
        to v
    ]

    [ :dictionary ( -- node:v )
        48 +
        @
        to v
    ]

    [ :data-stack ( -- :v )
        56 +
        @
        to v
    ]

    [ :native-stack ( -- :v )
        64 +
        @
        to v
    ]

    [ :code-desc ( -- str:v )
        [ :panic-state "Invalid state" ]
        [ :panic-dict-notfound "Key in dictionary not found" ]
        [ :panic-dict-overflow "Dictionary overflow" ]
        [ :panic-stack-underflow "Data stack underflow" ]
        [ :panic-stack-overflow "Data stack overflow" ]
        [ :panic-token-invalid "Invalid token" ]
        [ :panic-token-overflow "Token too long" ]
        [ :panic-token-noclose "Expected closing token" ]
        [ :panic-token-noopen "Expected open token" ]
        [ :panic-compile-node "Encountered a node which should only be compiled" ]
        [ :panic-div-zero "Divide by zero" ]
        [ :panic-local "Invalid local" ]
        [ :panic-unhandled "Unhandled" ]

        code @
        [
            ^ 1 = ? panic-state 
            ^ 2 = ? panic-dict-notfound
            ^ 3 = ? panic-dict-overflow
            ^ 4 = ? panic-stack-underflow
            ^ 5 = ? panic-stack-overflow
            ^ 6 = ? panic-token-invalid
            ^ 7 = ? panic-token-overflow
            ^ 8 = ? panic-token-noclose
            ^ 9 = ? panic-token-noopen
            ^ 10 = ? panic-compile-node
            ^ 11 = ? panic-div-zero
            ^ 12 = ? panic-local
            ? panic-unhandled
        ]
        to v
    ]
]

[ :debugger ( frame:f -- )
    
    "Panic: " str~.
    f frame~code-desc str~.

    "State: " str~.
    f frame~state @ .

    "Definition: " str~.
    f frame~definition @ .

    "Instruction: " str~.
    f frame~instruction @ .

    "TOS: " str~.
    f frame~tos @ .
]

' debugger core~panic-handler !

# test underflow handling
_

# must end on newline
