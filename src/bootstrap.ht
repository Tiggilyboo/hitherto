# words which point to internal core qword addresses in kernel
[ :core
    # 0..31 can be accessed via $0..31 for register bank
    [ :panic-handler $32 ]
    [ :io-data $33 ]
    [ :io-length $34 ]
]

[ :linux
    # read: fd buf count -> result
    # Linux syscall 0
    [ :read
        $3 !        # count
        $2 !        # buffer address
        $1 !        # file descriptor
        0 $0 !      # SYS_read
        sys
        $0 @        # return value
    ]

    # write: fd buf count -> result
    # Linux syscall 1
    [ :write
        $3 !        # count
        $2 !        # buffer address
        $1 !        # file descriptor
        1 $0 !      # SYS_write
        sys
        $0 @        # return value
    ]

    # open: filename -> fd
    # Linux syscall 2
    [ :open
        0 $2 !      # mode
        0 $1 !      # O_RDONLY
        $0 !        # filename address
        2 $0 !      # SYS_open
        sys
        $0 @        # return fd
    ]

    # exit: status -> nothing
    # Linux syscall 60
    [ :exit
        $1 !        # exit status
        60 $0 !     # SYS_exit
        sys
    ]

    # mmap: length -> result
    # Linux syscall 9
    [ :mmap
        $2 !        # length, consume from stack
        9 $0 !      # SYS_MMAP
        0 $1 !      # addr = null
        3 $3 !      # PROT_READ | PROT_WRITE
        34 $4 !     # MAP_PRIVATE | MAP_ANONYMOUS
        -1 $5 !     # fd
        0 $6 !      # offset
        sys
        $0 @        # return value
    ]
]

# standard numeric data types
[ :u8
    [ :& 0xff & ]
    [ :@
        [ 0x4d 0x0f 0xb6 0x6d 0x00 asm ]
    ]
    [ :!
        [
            0x41 0x8a 0x47 0xf8       # mov al, byte ptr [r15 - 8]
            0x41 0x88 0x45 0x00       # mov byte ptr [r13], al
            asm
        ]
        _ _
    ]
]
[ :u32
    [ :& 0xffffffff & ]
]

[ :memory
    [ :ptr ]
    [ :len ]
    [ :span
        ^ ptr
        >< len
    ]
]

# str is a printable memory span (ie. the string type)
[ memory:str
    [ :ptr
        ^ @
        u32~&
        +
    ]
    [ :len
        @
        ^
        32 >>
        ><
        u32~&
        -
    ]
    [ :.
        [ :write-err 1 linux~exit ]
        1 # stdout
        ><
        span
        linux~write
        0 < ? write-err
    ]
]

[ :input
    [ :data core~io-data ]
    [ :len core~io-length ]

    [ :span
        data
        len @
    ]

    [ :eof ]
    [ :error ]

    [ :refill
        0
        data
        8
        linux~read

        ^ 0 < ? error
        ^ 0 = ? eof

        len !
    ]
    
    [ :read ( -- u8:v )
        [
            len @ 0 = ? refill
        ]

        data @
        u8~& to v

        data @ 8 >> data !
        len @ 1 - len !
    ]
]
[ input:str-parser
    [ :eof 8 panic ]
    [ :error 13 panic ]
]


# arena allocator
[ :arena
    [ :ptr
        [ :init
            [ :mmap-err
                -1
                linux~exit
            ]
            1048576 linux~mmap
            [
                ^ 0 < ? mmap-err
            ]

            # [base + 0] = base + 16
            ^ 16 + <^ !

            # [base + 8] = base + 1048576
            ^ 1048576 + <^ 8 + !

            lit
            immediate
        ]
        init
    ]
    [ :cursor
        ptr @
    ]
    [ :seek
        ptr !
    ]
    [ :end
        ptr 8 + @
    ]
    [ :len
        end ptr -
    ]
    [ :remaining
        end cursor -
    ]
    [ :used
        ptr 16 +
        cursor ptr 16 + -
    ]
    [ :span
        ptr 16 +
        used
    ]
    [ :alloc
        [ :overflow 3 panic ]
        cursor ><

        # preserve cursor and increment
        <^ +

        # if > end, fail
        [
            ^ end >< < ? overflow
        ]

        # store next as new cursor, discard it
        # leaves old cursor as allocation result
        ^ seek _
    ]
]


# String literals
[ :"
    [ :overflow
        3 panic
    ]
    [ :done ( str:s u8:c -- )
        arena~cursor
        s -
        32 <<
        8 |
        s !

        s lit
    ]

    # reserve qword length
    8 arena~alloc

    [
        # stack: str cursor
        arena~cursor
        ^ arena~end < 0 = ? overflow
        _

        # str char
        str-parser~read

        # check if character is "
        ^ 34 = ? done

        # str char cursor -> str
        arena~cursor
        u8~!
        
        arena~cursor
        1 +
        arena~seek

        ~[
    ]

    immediate
]

# kernel/core node format for internal representation of memory for a word
[ :node
    [ :code ( -- :v )
        @
        to v
    ]
    [ :type ( -- node:v )
        8 +
        @
        -8 &
        to v
    ]
    [ :end ( -- :v )
        16 +
        @
        to v
    ]
    [ :body ( -- :v )
        24 +
        to v
    ]
    [ :name ( -- str:v )
        body
        to v
    ]
]

[ :frame
    [ :code ( -- :v )
        @
        to v
    ]

    [ :state ( -- :v )
        8 +
        @
        to v
    ]

    [ :definition ( -- node:v )
        16 +
        @
        to v
    ]

    [ :scope ( -- :v )
        24 +
        @
        to v
    ]

    [ :instruction ( -- :v )
        32 +
        @
        to v
    ]

    [ :tos ( -- :v )
        40 +
        @
        to v
    ]

    [ :dictionary ( -- node:v )
        48 +
        @
        to v
    ]

    [ :data-stack ( -- :v )
        56 +
        @
        to v
    ]

    [ :native-stack ( -- :v )
        64 +
        @
        to v
    ]

    [ :code-desc ( -- str:v )
        [ :panic-state "Invalid state" ]
        [ :panic-dict-notfound "Key in dictionary not found" ]
        [ :panic-dict-overflow "Dictionary overflow" ]
        [ :panic-stack-underflow "Data stack underflow" ]
        [ :panic-stack-overflow "Data stack overflow" ]
        [ :panic-token-invalid "Invalid token" ]
        [ :panic-token-overflow "Token too long" ]
        [ :panic-token-noclose "Expected closing token" ]
        [ :panic-token-noopen "Expected open token" ]
        [ :panic-compile-node "Encountered a node which should only be compiled" ]
        [ :panic-div-zero "Divide by zero" ]
        [ :panic-local "Invalid local" ]
        [ :panic-unhandled "Unhandled" ]

        code @
        [
            ^ 1 = ? panic-state 
            ^ 2 = ? panic-dict-notfound
            ^ 3 = ? panic-dict-overflow
            ^ 4 = ? panic-stack-underflow
            ^ 5 = ? panic-stack-overflow
            ^ 6 = ? panic-token-invalid
            ^ 7 = ? panic-token-overflow
            ^ 8 = ? panic-token-noclose
            ^ 9 = ? panic-token-noopen
            ^ 10 = ? panic-compile-node
            ^ 11 = ? panic-div-zero
            ^ 12 = ? panic-local
            ? panic-unhandled
        ]
        to v
    ]
]

[ :debugger ( frame:f -- )
    
    "Panic: " str~.
    f frame~code-desc str~.

    "State: " str~.
    f frame~state @ .

    "Definition: " str~.
    f frame~definition @ .

    "Instruction: " str~.
    f frame~instruction @ .

    "TOS: " str~.
    f frame~tos @ .
]

' debugger core~panic-handler !

# test underflow handling
_

# must end on newline
