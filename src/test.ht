[ linux:linux
    [ :clock-gettime ( :clock-id addr:tp -- :result )
        228
        clock-id
        tp
        0 0 0 0
        sys
        to result
    ]
]

[ :clock
    [ :buf
        [ :init
            16 arena~alloc
            lit
            immediate
        ]
        init
    ]

    [ :now ( -- u64:v )
        [ :error 13 panic ]

        1 # CLOCK_MONOTONIC
        buf
        linux~clock-gettime
        [
            ^ 0 < ? error
        ]
        _

        # timespec:
        # +0 sec
        # +8 nsec
        buf u64~@
        1000000000 *
        buf 8 + u64~@
        +
        to v
    ]
]

[ :timestamp
    [ :init
        8 arena~alloc
        lit
        immediate
    ]
    init
]

# abort the test: the runner reports the failure
[ :fail ( -- )
    -1 linux~exit
]

# a passing assert falls through, so a test can assert as often as it likes;
# the runner derives the verdict from the exit status
[ :assert ( addr:actual addr:expected -- )
    [ :mismatch
        actual .
        " != " str~.
        expected .
        ascii~.\n
        fail
    ]

    [
        actual expected = 0 = ? mismatch
    ]
]

# timing belongs to a benchmark, not to every test: bench/finish print the
# elapsed time themselves
[ :bench
    clock~now
    timestamp u64~!
]

[ :finish
    clock~now
    timestamp u64~@
    -
    .
    " ns" str~.\n

    0 linux~exit
]
