]

[ :pass
    "PASS" str~.\n
]
[ :fail
    "FAIL" str~.\n
    0 panic
]

[ :assert ( addr:actual addr:expected -- )
    actual expected =
    ? pass
    fail
]

[ :construct-node ( -- node:n addr:next )
    [ :test-fn
        "Chicken" str~.\n
    ]
 
    "Test"
    core~exec @
    dict~here
    node~new

    to next
    to n

    n next node~finalize
    n dict~add

    "Test" dict~find
    n
    assert
]

