[ module:test import "../src/test.ht" ]

[ :expect-invalid ( frame:f -- )
    # success is silence: the runner's exit status is the verdict
    [ :ok 0 linux~exit ]

    f frame~code
    6 =
    ? ok

    "expected Invalid token (6), got " str~.
    f frame~code-desc str~.
    " (" str~.
    f frame~code .
    ")" str~.\n
    -1 linux~exit
]

' expect-invalid core~panic-handler !

[ :invalid-parent-local ( :x -- )
    [ :child ( :x -- ) ]
]

-1 linux~exit
