# untyped basic stack operations: all behaviour described by their signatures
[ :^ ( :a -- a a ) ]
[ :_ ( :a -- ) ]
[ :>< ( :a :b -- b a ) ]
[ :<^ ( :a :b -- a b a ) ]

# untyped operations
[ :+ ( :a :b -- a )
    a b
    [
        0x4d 0x03 0x6f 0xf8 # add r13, qword ptr [r15 - 8]
        asm
    ]
    to a
]
[ :- ( :a :b -- a )
    a b
    [
        0x49 0x8b 0x47 0xf8 # mov rax, qword ptr [r15 - 8]
        0x4c 0x29 0xe8      # sub rax, r13
        0x49 0x89 0xc5      # mov r13, rax
        asm
    ]
    to a
]
[ :* ( :a :b -- a )
    a b
    [
        0x4d 0x0f 0xaf 0x6f 0xf8 # imut r13, qword ptr [r15 - 8]
        asm
    ]
    to a
]
[ :& ( :a :b -- a )
    a b
    [
        0x4d 0x23 0x6f 0xf8 # and r13, qword ptr [r15 - 8]
        asm
    ]
    to a
]
[ :| ( :a :b -- a )
    a b
    [
        0x4d 0x0b 0x6f 0xf8 # or r13, qword ptr [r15 - 8]
        asm
    ]
    to a
]
[ :<< ( :a :b -- a )
    a b
    [
        0x4c 0x89 0xe9      # mov rcx, r13
        0x4d 0x8b 0x6f 0xf8 # mov r13, qword ptr [r15 - 8]
        0x49 0xd3 0xe5      # shl r13, cl
        asm
    ]
    to a
]
[ :>> ( :a :b -- a )
    a b
    [
        0x4c 0x89 0xe9      # mov rcx, r13
        0x4d 0x8b 0x6f 0xf8 # mov r13, qword ptr [r15 - 8]
        0x49 0xd3 0xed      # shr r13, cl
        asm
    ]
    to a
]
[ := ( :a :b -- :c )
    a b
    [
        0x4d 0x39 0x6f 0xf8 # cmp qword ptr [r15 - 8], r13
        0x41 0x0f 0x94 0xc5 # sete r13b
        0x4d 0x0f 0xb6 0xed # movzx r13, r13b
        asm
    ]
    to c
]
[ :< ( :a :b -- :c )
    a b
    [
        0x4d 0x39 0x6f 0xf8 # cmp qword ptr [r15 - 8], r13
        0x41 0x0f 0x9c 0xc5 # setl r13b
        0x4d 0x0f 0xb6 0xed # movzx r13, r13b
        asm
    ]
    to c
]
[ :/% ( :a :b -- :q :r )
    [ :zero 11 panic ]
    b 0 = ? zero
    a b
    [
        0x4c 0x89 0xe9      # mov rcx, r13
        0x49 0x8b 0x47 0xf8 # mov rax, [r15 - 8]
        0x48 0x99           # cqo
        0x48 0xf7 0xf9      # idiv rcx
        
        # replace a b on the stack with quotient (q) and remainder (r)
        0x49 0x89 0x47 0xf8 # mov [r15 - 8], rax
        0x49 0x89 0xd5      # mov r13, rdx
        asm
    ]
    to r
    to q
]
[ :/ ( :a :b -- a )
    a b /%
    _ # discard remainder
    to a
]
[ :% ( :a :b -- a )
    a b /%
    >< _ # discard quotient
    to a
]
[ :@ ( :a -- :b )
    a
    [
        0x4d 0x8b 0x6d 0x00 # mov r13, qword ptr [r13]
        asm
    ]
    to b
]
[ :! ( :a :b -- )
    a b
    [
        0x49 0x8b 0x47 0xf8 # mov rax, qword ptr [r15 - 8]
        0x49 0x89 0x45 0x00 # mov qword ptr [r13], rax
        asm
    ]
]

# jump to the address in TOS
[ :~_
    [
        0x4c 0x89 0xe8      # mov rax, r13
        0x49 0x83 0xef 0x08 # sub r15, 8
        0x4d 0x8b 0x2f      # mov r13, [r15]
        0x48 0x8b 0x10      # mov rdx, [rax]
        0xff 0xe2           # jmp rdx
        asm
    ]
]

[ :sys ( :rax :rdi :rsi :rdx :r10 :r8 :r9 -- :r )
    rax rdi rsi rdx r10 r8 r9
    [
        0x49 0x8b 0x47 0xd0 # mov rax, [r15 - 48]
        0x49 0x8b 0x7f 0xd8 # mov rdi, [r15 - 40]
        0x49 0x8b 0x77 0xe0 # mov rsi, [r15 - 32]
        0x49 0x8b 0x57 0xe8 # mov rdx, [r15 - 24]
        0x4d 0x8b 0x57 0xf0 # mov r10, [r15 - 16]
        0x4d 0x8b 0x47 0xf8 # mov r8,  [r15 - 8]
        0x4d 0x89 0xe9      # mov r9, r13
        0x0f 0x05           # syscall
        0x49 0x89 0xc5      # mov r13, rax
        asm
    ]
    to r
]

# words which point to internal core qword addresses in kernel
[ :core
    [ :panic-handler $0 lit immediate ]
    [ :argc $1 lit immediate ]
    [ :argv $2 lit immediate ]
    [ :source-fd $3 lit immediate ]
    [ :source-dirfd $4 lit immediate ]
    [ :source-data $5 lit immediate ]
    [ :source-len $6 lit immediate ]

    [ :dict $7 @ lit immediate ]
    [ :dict-end $8 @ lit immediate ]
    [ :dict-tail@ $9 lit immediate ]
    [ :dict-tail! $10 lit immediate ]

    [ :lit-ptr $11 lit immediate ]
    [ :branch $12 lit immediate ]
    [ :ctrl-push $13 lit immediate ]
    [ :ctrl-pop $14 lit immediate ]
    [ :skip $15 lit immediate ]
    [ :native $16 lit immediate ]
    [ :member $17 lit immediate ]
    [ :local@ $18 lit immediate ]
    [ :local! $19 lit immediate ]
    [ :exec $20 lit immediate ]

    [ :scope-stack $21 lit immediate ]
    [ :data-stack $22 lit immediate ]
]

# qword allocation in the data stack
[ :cell
    [ :field ( :v :offset :mask -- :o )
        v
        offset >>
        mask
        &
        to o
    ]
    [ := ( :a :b -- :c )
        a &
        b &
        =
        to c
    ]
]

[ cell:b8
    [ :mask ( -- :a )
        0xff to a
        immediate
    ]
    [ :& ( :a -- a )
        a
        0xff &
        to a
    ]
    [ :@ ( :a -- :b )
        a
        [ 0x4d 0x0f 0xb6 0x6d 0x00 asm ]
        to b
    ]
    [ :! ( :a :b -- )
        a b
        [
            0x41 0x8a 0x47 0xf8       # mov al, byte ptr [r15 - 8]
            0x41 0x88 0x45 0x00       # mov byte ptr [r13], al
            asm
        ]
    ]
]
[ cell:b16
    [ :mask ( -- :v )
        0xffff to v
        immediate
    ]
    [ :& ( :a -- a )
        a
        0xffff &
        to a
    ]
    [ :@ ( :a -- :b )
        a
        [
            0x4d 0x0f 0xb7 0x6d 0x00 # movzx r13, word ptr [r13]
            asm
        ]
        to b
    ]
    [ :! ( :a :b -- )
        a b
        [
            0x66 0x41 0x8b 0x47 0xf8 # mov ax, word ptr [r15 - 8]
            0x66 0x41 0x89 0x45 0x00 # mov word ptr [r13], ax
            asm
        ]
    ]
]
[ cell:b32
    [ :mask ( -- :v )
        0xffffffff to v
        immediate
    ]
    [ :& ( :a -- a )
        a
        0xffffffff &
        to a
    ]
    [ :@ ( :a -- :b )
        a
        [
            # mov r13d, dword ptr [r13]
            0x45 0x8b 0x6d 0x00
            asm
        ]
        to b
    ]
    [ :! ( :a :b -- )
        a b
        [
            0x41 0x8b 0x47 0xf8 # mov eax, dword ptr [r15 - 8]
            0x41 0x89 0x45 0x00 # mov dword ptr [r13], eax
            asm
        ]
    ]
]
[ cell:b64
    [ :mask ( -- :v )
        0xffffffffffffffff to v
        immediate
    ]

    # noop, already 64 bit qword
    [ :& ( :a -- a ) a to a ] 

    [ :@ ( :a -- :b )
        a
        [
            0x4d 0x8b 0x6d 0x00 # mov r13, qword ptr [r13]
            asm
        ]
        to b
    ]
    [ :! ( :a :b -- )
        a b
        [
            0x49 0x8b 0x47 0xf8 # mov rax, qword ptr [r15 - 8]
            0x49 0x89 0x45 0x00 # mov qword ptr [r13], rax
            asm
        ]
    ]
]
[ b8:u8 ]
[ b16:u16 ]
[ b32:u32 ]

[ b64:u64
    [ :align ( u64:v u64:a -- v )
        v
        a 1 - +
        0 a -
        &
        to v
    ]
    
]

[ b8:i8
    # mask 8 bits, then sign extend
    [ :&
        b8~&
        [
            # movsx r13, r13b
            0x4d 0x0f 0xbe 0xed 
            asm
        ]
    ]
    [ :@
        [
            # movsx r13, byte ptr [r13]
            0x4d 0x0f 0xbe 0x6d 0x00 
            asm
        ]
    ]
]

[ b16:i16
    [ :&
        b16~&
        [
            # movsx r13, r13w
            0x4d 0x0f 0xbf 0xed
            asm
        ]
    ]
    [ :@
        [
            # movsx r13, word ptr [r13]
            0x4d 0x0f 0xbf 0x6d 0x00
            asm
        ]
    ]
]
[ b32:i32
    [ :&
        b32~&
        [
            # movsxd r13, r13d
            0x4d 0x64 0xed
            asm
        ]
    ]
    [ :@
        [
            # movsxd r13, dword ptr [r13]
            0x4d 0x64 0x6d 0x00
            asm
        ]
    ]
]
[ b64:i64 ]

# address is the value of a pointer
[ :addr
    # align the address to byte size
    [ :align ( addr:p u64:a -- addr:q )
        p
        a 1 - +
        0 a -
        &
        to q
    ]
]

# Defines an arbitrary segment of memory
[ :memory
    # ptr to start of memory region
    [ addr:ptr ]
    # length in bytes
    [ u64:len ]
    [ :span
        ^ ptr
        >< len
    ]
]

[ :linux
    [ :read ( u32:fd addr:buf u64:count -- :result )
        0
        fd
        buf
        count
        0
        0
        0
        sys
        to result
    ]

    [ :write ( u32:fd addr:buf u64:count -- :result )
        1
        fd
        buf
        count
        0
        0
        0
        sys
        to result
    ]

    [ :open ( addr:path u32:flags u32:mode -- u32:fd )
        2 path flags mode 0 0 0
        sys
        to fd
    ]

    [ :close ( :fd -- :result )
        3
        fd
        0 0 0 0 0
        sys
        to result
    ]

    [ :fstat ( :fd addr:stat -- :result )
        5
        fd
        stat
        0 0 0 0
        sys
        to result
    ]
    
    [ :exit ( u32:code  -- )
        60 code
        0 0 0 0 0
        sys
    ]

    [ :mmap ( addr:ptr u64:len u32:prot u32:flags u32:fd u32:offset -- :result )
        9
        ptr
        len
        prot
        flags
        fd
        offset
        sys
        to result
    ]

    [ :openat ( :dirfd addr:path u32:flags u32:mode -- :fd )
        257
        dirfd
        path
        flags
        mode
        0
        0
        sys
        to fd
    ]
]

# arena allocator
[ :arena
    [ :ptr
        [ :init
            [ :mmap-err -1 linux~exit ]

            0
            1048576
            3 # PROT_READ | PROT_WRITE
            0x22 # MAP_PRIVATE | MAP_ANONYMOUS
            -1
            0
            linux~mmap
            [ ^ 0 < ? mmap-err ]

            # [base + 0] = base + 16
            ^ 16 + <^ !

            # [base + 8] = base + 1048576
            ^ 1048576 + <^ 8 + !

            lit
            immediate
        ]
        init
    ]
    [ :cursor
        ptr @
    ]
    [ :seek
        ptr !
    ]
    [ :end
        ptr 8 + @
    ]
    [ :len
        end ptr -
    ]
    [ :remaining
        end cursor -
    ]
    [ :used
        ptr 16 +
        cursor ptr 16 + -
    ]
    [ :span
        ptr 16 +
        used
    ]
    [ :alloc
        [ :overflow 3 panic ]
        cursor ><

        # preserve cursor and increment
        <^ +

        # if > end, fail
        [
            ^ end >< < ? overflow
        ]

        # store next as new cursor, discard it
        # leaves old cursor as allocation result
        ^ seek _
    ]
]

[ :output
    [ :buf
        [ :len 32 lit immediate ]
        [ :init
            len
            arena~alloc
            lit
            immediate
        ]
        init
    ]
]

[ :input
    [ :data core~source-data ]
    [ :len core~source-len ]

    [ :span
        data
        len @
    ]

    [ :eof ]
    [ :error ]

    [ :refill
        core~source-fd @
        data
        8
        linux~read

        ^ 0 < ? error
        ^ 0 = ? eof

        len !
    ]
    
    [ :read ( -- u8:v )
        [
            len @ 0 = ? refill
        ]

        data @
        u8~& to v

        data @ 8 >> data !
        len @ 1 - len !
    ]
]
[ input:str-parser
    [ :eof 8 panic ]
    [ :error 13 panic ]
]

[ b8:ascii
    [ :code
        [ :\n 10 lit immediate ]
        [ :space 32 lit immediate ]
        [ :" 34 lit immediate ]
        [ :0 48 lit immediate ]
        [ :- 45 lit immediate ]
        [ :/ 47 lit immediate ]
    ]

    [ :. ( b8:v -- )
        [ :err 13 panic ]

        v output~buf
        u8~!

        1 # stdout
        output~buf
        1 # len
        linux~write
        ^ 0 < ? err
    ]
    [ :.\n ( -- )
        code~\n
        .
    ]
]

# str is a printable memory span (ie. the string type)
[ memory:str
    [ :ptr ( str:s -- addr:p )
        s
        s @
        u32~&
        +
        to p
    ]
    [ :len ( str:s -- u32:l )
        s @
        ^
        32 >>
        ><
        u32~&
        -
        to l
    ]
    [ :. ( str:s -- )
        [ :err 13 panic ]
        1 # stdout
        s
        span
        linux~write
        0 < ? err
    ]
    [ :.\n ( str:s -- )
        s .
        ascii~code~\n
        ascii~.
    ]
    [ :eq ( str:a str:b -- :is-eq )
        [ :not-eq 0 to is-eq ]
        [ :eq 1 to is-eq ]

        [ :cmp-tail ( addr:i addr:j u64:n -- )
            [
                n 0 = ? eq

                i u8~@
                j u8~@
                =
                0 = ? not-eq

                i 1 + to i
                j 1 + to j
                n 1 - to n
                ~[
            ]
        ]

        [ :cmp-values ( addr:i addr:j u64:n -- )
            [ :tail
                i j n
                cmp-tail
            ]
            [
                n 8 < ? tail

                i b64~@
                j b64~@
                =
                0 = ? not-eq

                i 8 + to i
                j 8 + to j
                n 8 - to n
                ~[
            ]
        ]
        a len
        b len =
        0 = ? not-eq

        a ptr
        b ptr
        = ? eq

        a ptr
        b ptr
        a len
        cmp-values
    ]
]

[ :. ( :v -- )
    [ :err 13 panic ]

    [ :digits ( :n addr:p -- p :len )

        0 to len
        [
            n 10 /%
            >< to n # remainder on stack

            # signed remainder -> digit
            ^ 0 < 2 *
            <^ * -
            ascii~code~0
            +

            p 1 - to p
            p u8~!

            len 1 + to len

            [ n 0 = ? ~] ]
            ~[
        ]
    ]
    [ :sign ( addr:p :len -- p len )
        p 1 - to p
        ascii~code~-
        p u8~!
        len 1 + to len
    ]
    
    1 # stdout
    v
    output~buf output~buf~len +
    digits

    [
        v 0 < ? sign
    ]
    
    # stack: fd start len
    linux~write

    ^ 0 < ? err
    _
]

# String literals
[ :quoted-str
    [ :overflow 3 panic ]

    [ :done ( str:s u8:c -- s )
        arena~cursor
        s -
        32 <<
        8 |
        s !
    ]

    8 arena~alloc

    [
        # stack: str cursor
        arena~cursor
        ^ arena~end < 0 = ? overflow
        _

        # str char
        str-parser~read

        # check if character is "
        ^ ascii~code~" = ? done

        # str char cursor -> str
        arena~cursor
        u8~!
        
        arena~cursor
        1 +
        arena~seek

        ~[
    ]
]

[ :"
    quoted-str
    lit
    immediate
]

# cstr is null terminated str usually used for C ffi
[ str:cstr
    [ :ptr ( cstr:s -- addr:p )
        s to p
    ]
    [ :len ( cstr:s -- u64:n )
        0 to n
        [
            s n +
            u8~@
            0 = ? ~]

            n 1 + to n
            ~[
        ]
    ]
]

[ :quoted-cstr ( -- cstr:s )
    quoted-str

    # null terminated
    0 arena~cursor u8~!
    arena~cursor
    1 +
    arena~seek

    # cstr is the actual pointer not a str descriptor
    str~ptr
    to s
]

[ :c"
    quoted-cstr
    lit
    immediate
]

# kernel/core node format for internal representation of memory for a word
[ :node
    [ :code
        [ :ref ( node:n -- addr:p )
            n to p
        ]

        [ :@ ( node:n -- addr:v )
            n ref b64~@
            to v
        ]

        [ :! ( addr:v node:n -- )
            v
            n ref
            b64~!
        ]
    ]

    [ :type
        [ :ref ( node:n -- addr:p )
            n 8 + to p
        ]

        [ :@ ( node:n -- node:t )
            n ref
            b64~@
            -8 &
            to t
        ]

        [ :! ( node:t node:n -- )
            # preserve low flag bits
            n ref b64~@
            7 &
            t -8 &
            |
            n ref
            b64~!
        ]
    ]

    [ :end
        [ :ref ( node:n -- addr:p )
            n 16 + to p
        ]

        [ :@ ( node:n -- addr:v )
            n ref
            b64~@
            to v
        ]

        [ :! ( addr:v node:n -- )
            v
            n ref
            b64~!
        ]
    ]

    [ :prev
        [ :ref ( node:n -- addr:p )
            n end~@
            to p
        ]

        [ :@ ( node:n -- node:v )
            n ref b64~@
            to v
        ]

        [ :! ( node:v node:n -- )
            v
            n ref
            b64~!
        ]
    ]

    [ :body ( node:n -- addr:v )
        n 24 + to v
    ]

    [ :name ( node:n -- str:v )
        n body to v
    ]
    [ :defs ( node:n -- addr:p )
        n body
        n body @
        32 >>
        +
        8 addr~align
        to p
    ]

    [ :local
        [ :binding ( node:n -- :v )
            n defs
            8 +
            @
            to v
        ]
        [ :count ( node:n -- u64:count )
            n binding
            8 >>
            0xf &
            to count
        ]
        [ :slot ( node:n -- u8:i )
            n binding
            7 &
            to i
        ]
        [ :at ( node:n u8:i -- node:l )
            n defs
            16 +
            to l

            [
                i 0 = ? ~]

                l end~@
                8 +
                to l

                i 1 - to i

                ~[
            ]
        ]
    ]

    [ :new ( str:s addr:fn addr:at -- node:n addr:next )
        [ :overflow 3 panic ]

        at to n

        # next = body + aligned(name desc + bytes) + local tail + prev
        n body
            n str~len
            8 +
        +
        8
        addr~align
        16 +
        to next

        [
            core~dict-end next < ? overflow
        ]

        fn n code~!
        0 n type~ref b64~!

        # name desc
        s str~len
        8 +
        32 <<
        8 |
        n body
        b64~!

        # copy name bytes
        s str~ptr to at
        n name str~ptr to fn
        s str~len to s

        [
            [ s 0 = ? ~] ]

            at u8~@
            fn u8~!

            at 1 + to at
            fn 1 + to fn
            s 1 - to s

            ~[
        ]

        0 n defs b64~!

        n defs
        8 +
        n end~!

        0 n prev~!
    ]

    [ :finalize ( node:n addr:p -- )
        p n end~!
        0 n prev~!
    ]

    [ :match ( node:n str:s -- :found )
        n name
        s
        str~eq
        to found
    ]
]

[ :dict
    [ :base core~dict lit immediate ]
    [ :end core~dict-end lit immediate ]
    [ :tail
        [ :@ core~dict-tail@ ~_ ]
        [ :! core~dict-tail! ~_ ]
    ]

    [ :here ( -- addr:p )
        [ :first base to p ]

        tail~@
        [
            ^ 0 = ? first
            node~end~@
            8 +
            to p
        ]
    ]

    [ :add ( node:n -- )
        tail~@
        n node~prev !
        n tail~!
    ]

    [ :find ( node:n str:s -- node:v )
        n node~defs
        @
        to v

        [
            v 0 = ? ~]

            [
                v s node~match ? ~]
            ]

            v node~prev~@
            to v

            ~[
        ]
    ]
]

[ :scope-tag
    [ :& ( :v -- scope-tag:t )
        v 7 &
        to t
    ]
    [ :parent ( -- scope-tag:v )
        1 to v immediate
    ]
    [ :context ( -- scope-tag:v )
        2 to v immediate
    ]
    [ :compile ( -- scope-tag:v )
        4 to v immediate
    ]
]

[ :scope-index
    [ :& ( :v -- scope-index:i )
        v 0x3fff &
        to i
    ]
]

# format for scope elements in the scope stack
[ :scope
    [ :tag ( scope:s -- scope-tag:t )
        s scope-tag~&
        to t
    ]
    [ :node ( scope:s -- node:n )
        s -8 &
        to n
    ]
    [ :invocation
        [ :owner ( scope:s -- node:n )
            s
                core~dict-end
                core~dict
                -
            8 - &
            core~dict
            +
            to n
        ]
        [ :local-base ( scope:s -- addr:p )
            s 17 >>
            scope-index~&
            8 *
            core~data-stack @
            +
            to p
        ]
        [ :valid ( scope:s -- u8:v )
            s 31 >>
            u8~&
            to v
        ]
        [ :body-floor ( scope:s -- addr:p )
            s 39 >>
            scope-index~&
            8 *
            core~data-stack @
            +
            to p
        ]

        [ :stack-depth ( scope:s addr:cursor -- u64:n )
            cursor
            s body-floor
            -
            3 >>
            to n
        ]
    ]
]

[ :frame
    [ :code ( frame:f -- :v )
        f
        @
        to v
    ]
    [ :state ( frame:f -- :v )
        f 8 +
        @
        to v
    ]
    [ :state-desc ( frame:f -- str:v )
        [ :exe "EXEC" ]
        [ :def "COMPILE" ]
        [ :unk "UNKNOWN" ]

        f state
        [
            ^ 0 = ? exe
            ^ 1 = ? def
            ? unk
        ]
        to v
    ]

    [ :definition ( frame:f -- node:v )
        f 16 + @
        to v
    ]

    [ :scope-stack ( frame:f -- :v )
        f 24 + @
        to v
    ]

    [ :instruction ( frame:f -- :v )
        f 32 + @
        to v
    ]

    [ :tos ( frame:f -- :v )
        f 40 + @
        to v
    ]

    [ :dictionary ( frame:f -- node:v )
        f 48 + @
        to v
    ]

    [ :data-stack ( frame:f -- :v )
        f 56 + @
        to v
    ]

    [ :native-stack ( frame:f -- :v )
        f 64 + @
        to v
    ]

    # cursor position of instruction node body
    [ :instruction-offset ( frame:f -- :v )
        f instruction
        f definition node~body
        -
        to v
    ]

    [ :code-desc ( frame:f -- str:v )
        [ :panic-state "Invalid state" ]
        [ :panic-dict-notfound "Key in dictionary not found" ]
        [ :panic-dict-overflow "Dictionary overflow" ]
        [ :panic-stack-underflow "Data stack underflow" ]
        [ :panic-stack-overflow "Data stack overflow" ]
        [ :panic-token-invalid "Invalid token" ]
        [ :panic-token-overflow "Token too long" ]
        [ :panic-token-noclose "Expected closing token" ]
        [ :panic-token-noopen "Expected open token" ]
        [ :panic-compile-node "Encountered a node which should only be compiled" ]
        [ :panic-div-zero "Divide by zero" ]
        [ :panic-local "Invalid local" ]
        [ :panic-unhandled "Unhandled" ]

        f code
        [
            ^ 1 = ? panic-state 
            ^ 2 = ? panic-dict-notfound
            ^ 3 = ? panic-dict-overflow
            ^ 4 = ? panic-stack-underflow
            ^ 5 = ? panic-stack-overflow
            ^ 6 = ? panic-token-invalid
            ^ 7 = ? panic-token-overflow
            ^ 8 = ? panic-token-noclose
            ^ 9 = ? panic-token-noopen
            ^ 10 = ? panic-compile-node
            ^ 11 = ? panic-div-zero
            ^ 12 = ? panic-local
            ? panic-unhandled
        ]
        to v
    ]

    [ :body-floor ( frame:f -- addr:p )
        [ :root
            _
            core~data-stack @
            to p
        ]

        [ :found
            >< _
            39 >>
            scope-index~&
            8 *
            core~data-stack @
            +
            to p
        ]

        f scope-stack
        [
            ^ core~scope-stack @ = ? root

            8 -
            ^ @

            ^ 0 <
            ? found

            _
            ~[
        ]
    ]

    [ :stack-depth ( frame:f -- u64:n )
        f data-stack
        f body-floor
        -
        3 >>
        to n
    ]

    [ :data-depth ( frame:f -- u64:n )
        f data-stack
        core~data-stack @
        -
        3 >>
        to n
    ]

    [ :call-stack ( frame:f -- )
        [ :locals ( scope:s -- )
            [ :walk ( u64:i u64:n -- )
                [ :show
                    "      " str~.

                    s scope~invocation~owner
                    i
                    node~local~at

                    ^ node~type~@
                    [
                        ^ 0 = ? _

                        node~name
                        str~.
                        " " str~.
                    ]

                    node~name
                    str~.

                    ": " str~.

                    s scope~invocation~local-base
                    i 8 * +
                    @
                    .

                    ascii~.\n
                ]

                [
                    i n = ? ~]

                    [
                        s scope~invocation~valid
                        1 i << &
                        0 =
                        0 =
                        ? show
                    ]

                    i 1 + to i

                    ~[
                ]
            ]

            0

            s scope~invocation~owner
            node~local~count

            walk
            ascii~.\n
        ]

        [ :walk ( addr:p u64:i -- )
            [ :invocation ( scope:s -- )
                " #" str~.
                i .
                " " str~.

                s scope~invocation~owner
                node~name
                str~.

                " stack: " str~.
                s
                f data-stack
                scope~invocation~stack-depth
                .

                ascii~.\n

                s locals

                i 1 + to i
            ]

            [
                p core~scope-stack @ = ? ~]

                p 8 - to p

                [
                    p @
                    ^ 0 < ? invocation
                    _
                ]

                ~[
            ]
        ]

        f scope-stack
        0
        walk
    ]
]

[ :debugger ( frame:f -- )
    [ :is-none "None" str~.\n ]

    [ :print-node ( node:n -- )
        n 0 = ? is-none

        n node~name str~.

        " (" str~.
        n .
        ")" str~.\n
    ]

    "Panic: " str~.
    f frame~code-desc str~.
    " (" str~.
    f frame~code .
    ")" str~.\n

    "State: " str~.
    f frame~state-desc str~.
    "(" str~.
    f frame~state .
    ")" str~.\n

    "Definition: " str~.
    f frame~definition
    print-node

    "IP Offset: " str~.
    f frame~instruction-offset .
    ascii~.\n

    "TOS: " str~.
    f frame~tos .
    ascii~.\n

    "Data: " str~.
    f frame~data-stack .
    " depth: " str~.
    f frame~stack-depth .
    ascii~.\n

    "Call stack:" str~.\n
    f frame~call-stack
]

' debugger core~panic-handler !
"Loaded debugger" str~.\n

[ :path
    [ :open ( cstr:q :base-dirfd -- :result-fd :result-dirfd )
        [ :invalid 6 panic ]

        [ :file-flags 0x80000 lit immediate ] # O_RDONLY | O_CLOEXEC
        [ :dir-flags 0x290000 lit immediate ] # O_PATH | O_DIRECTORY | O_CLOEXEC

        [ :last-slash ( addr:scan-p u64:scan-n -- addr:slash-p )
            0 to slash-p

            [
                [
                    scan-n 0 = ? ~]
                ]

                scan-n 1 - to scan-n
                scan-p scan-n + to slash-p

                [
                    slash-p u8~@
                    ascii~code~/ = ? ~]
                ]

                0 to slash-p
                ~[
            ]
        ]

        [ :no-slash ( cstr:name :base addr:slash -- :fd :dirfd )
            # Produce an owned directory fd because module~import
            # always closes result-dirfd after consuming the source.
            base
            c"."
            dir-flags
            0
            linux~openat

            ^ 0 < ? invalid
            to dirfd

            dirfd
            name
            file-flags
            0
            linux~openat

            ^ 0 < ? invalid
            to fd
        ]

        [ :with-slash ( cstr:name :base addr:slash -- :fd :dirfd )
            # Temporarily terminate the directory component.
            0 slash u8~!

            base
            name
            dir-flags
            0
            linux~openat

            # Restore before doing anything else with name.
            ascii~code~/
            slash u8~!

            ^ 0 < ? invalid
            to dirfd

            dirfd
            slash 1 +
            file-flags
            0
            linux~openat

            ^ 0 < ? invalid
            to fd
        ]

        q
        base-dirfd

        q
        q cstr~len
        last-slash

        [
            ^ 0 = ? no-slash
            with-slash
        ]

        to result-dirfd
        to result-fd
    ]
]

[ :module
    [ :import
        [ :invalid 6 panic ]

        [ :read-path ( -- cstr:q )
            str-parser~read
            ^ ascii~code~" =
            0 =
            ? invalid
            _

            quoted-cstr
            to q
        ]

        [ :consume (
            addr:mark
            :child-fd
            :child-dirfd
            :saved-fd
            :saved-dirfd
            :saved-data
            :saved-len
            --
        )
            # Reclaim temporary quoted path before compiling child source.
            mark arena~seek

            child-fd core~source-fd !
            child-dirfd core~source-dirfd !
            0 core~source-data !
            0 core~source-len !

            source

            saved-fd core~source-fd !
            saved-dirfd core~source-dirfd !
            saved-data core~source-data !
            saved-len core~source-len !

            child-fd
            linux~close
            0 < ? invalid

            child-dirfd
            linux~close
            0 < ? invalid
        ]

        # Preserve arena position before read-path allocates its cstr.
        arena~cursor

        read-path
        core~source-dirfd @
        path~open

        # Preserve parent source state.
        core~source-fd @
        core~source-dirfd @
        core~source-data @
        core~source-len @

        consume

        immediate
    ]
]

"Booted" str~.\n

[ module:cli import "src/cli.ht" ]

cli~start
